  certificateUrl        String?  @map("certificate_url")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([nextDueDate])
  @@map("water_quality_tests")
}

model ProfessionalLicense {
  id          String            @id @default(uuid()) @db.Uuid
  holderType  LicenseHolderType @map("holder_type")
  holderName  String            @map("holder_name")
  holderRefId String?           @map("holder_ref_id") @db.Uuid
  licenseNumber String?         @map("license_number")
  issuedAt    DateTime?         @map("issued_at") @db.Date
  expiryDate  DateTime          @map("expiry_date") @db.Date
  documentUrl String?           @map("document_url")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([expiryDate])
  @@map("professional_licenses")
}

model CanteenStaffHealthCertificate {
  id          String   @id @default(uuid()) @db.Uuid
  staffName   String   @map("staff_name")
  employeeId  String?  @map("employee_id") @db.Uuid
  canteenId   String?  @map("canteen_id") @db.Uuid
  expiryDate  DateTime @map("expiry_date") @db.Date
  blockWork   Boolean  @default(false) @map("block_work")
  documentUrl String?  @map("document_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([expiryDate])
  @@map("canteen_staff_health_certificates")
}

model StudentMedicationOrder {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  medicationName String  @map("medication_name")
  dose          String
  unit          String
  scheduleJson  Json     @map("schedule_json")
  requiresVitalsJson Json @default("{}") @map("requires_vitals_json")
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])
  doses   ScheduledDose[]

  @@map("student_medication_orders")
}

model ScheduledDose {
  id         String              @id @default(uuid()) @db.Uuid
  orderId    String              @map("order_id") @db.Uuid
  dueAt      DateTime            @map("due_at")
  status     ScheduledDoseStatus @default(PENDING)
  remindedAt DateTime?           @map("reminded_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  order           StudentMedicationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  administration  MedicationAdministration?

  @@index([dueAt, status])
  @@map("scheduled_doses")
}
