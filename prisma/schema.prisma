generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MEDICAL_MANAGER
  HEAD_NURSE
  NURSE
  PHARMACY
  CANTEEN_INSPECTOR
  HR
  SCHOOL_ADMIN
  DEPUTY_ADMIN
  EXECUTIVE
  EHS_OFFICER
  PSYCHOLOGIST
  SOCIAL_WORKER
  TEACHER
  VIEWER
}

enum VisitorType {
  STUDENT
  EMPLOYEE
}

enum TriageLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum VisitStatus {
  OPEN
  CLOSED
  REFERRED
}

enum VisitOutcome {
  TREAT_AND_RETURN
  OBSERVE_IN_CLINIC
  SENT_HOME
  GUARDIAN_PICKUP
  DOCTOR_REFERRAL
  HOSPITAL_REFERRAL
  AMBULANCE
  EMERGENCY
  FOLLOW_UP
}

enum StudentReferralStatus {
  PENDING
  RECEIVED
  IN_TREATMENT
  COMPLETED
}

enum ReferralSeverity {
  NORMAL
  URGENT
  EMERGENCY
}

enum ReferralReasonCategory {
  SYMPTOMS
  INJURY
  EMERGENCY
  CHRONIC_FOLLOWUP
  SCHEDULED_MEDICATION
  GENERAL_COMPLAINT
  OTHER
}

enum TransactionType {
  IN
  OUT
  TRANSFER
  RETURN
  DAMAGE
  EXPIRE
  ADJUSTMENT
}

enum StockScope {
  MAIN
  CLINIC
}

enum InternalStockRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum RecommendationStatus {
  PENDING
  APPROVED
  MODIFIED
  REJECTED
}

enum CircularPriority {
  NORMAL
  URGENT
  VERY_URGENT
}

enum CanteenItemResult {
  COMPLIANT
  NEEDS_FOLLOWUP
  NEAR_EXPIRY
  NON_COMPLIANT
  DISCARDED
}

enum ResponseLevel {
  CONSCIOUS
  RESPONDS_TO_PAIN
  UNRESPONSIVE
}

enum PsychSessionType {
  INDIVIDUAL
  GROUP
  EMERGENCY
  FOLLOWUP
}

enum SocialCaseType {
  FINANCIAL
  FAMILY
  BEHAVIORAL
  HEALTH
  ACADEMIC
}

enum AssessmentTool {
  GAD7
  PHQ9
  ADHD_RATING
  ADAPTIVE_BEHAVIOR
  PROJECTIVE
}

enum InternalReferralTarget {
  PSYCHOLOGY
  SOCIAL
  CLINIC
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboundMessageStatus {
  SIMULATED
  SENT
  FAILED
}

enum OutboundChannel {
  SMS
  WHATSAPP
  EMAIL
  PUSH
}

enum OwnerType {
  STUDENT
  EMPLOYEE
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
}

enum ShiftType {
  MORNING
  AFTERNOON
  FULL_DAY
}

enum SafetyInspectionType {
  FIRST_AID
  AED
  EMERGENCY_EXIT
  GENERAL
  SCIENCE_CHEMISTRY
  SCIENCE_PHYSICS
  SCIENCE_BIOLOGY
  WATER_QUALITY
  FIRE_SAFETY
  EMERGENCY_EGRESS
}

enum LabAssetType {
  EYEWASH
  EMERGENCY_SHOWER
  FUME_HOOD
  GAS_DETECTOR
  GAS_CYLINDER
  FIRE_EXTINGUISHER_CO2
  FIRE_EXTINGUISHER_DCP
}

enum LicenseHolderType {
  CLINIC
  NURSE
  CANTEEN_STAFF
  OTHER
}

enum ScheduledDoseStatus {
  PENDING
  DUE
  ADMINISTERED
  SKIPPED
  MISSED
}

enum NotificationType {
  IN_APP
  STOCK
  EXPIRY
  EMERGENCY
  RECOMMENDATION
  PERIODIC_CHECK
  REFERRAL
  FREQUENT_VISITOR
  MED_DOSE_REMINDER
}

enum MedicationCategory {
  MEDICINE
  SUPPLY
}
model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinics  Clinic[]
  canteens Canteen[]

  @@map("schools")
}

model Clinic {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  name         String
  location     String?
  isMainStore  Boolean  @default(false) @map("is_main_store")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school              School               @relation(fields: [schoolId], references: [id])
  users               User[]
  students            Student[]
  employees           Employee[]
  visits              Visit[]
  studentReferrals    StudentReferral[]
  medications         Medication[]
  medicationBatches   MedicationBatch[]
  stockRequestsTo     InternalStockRequest[] @relation("StockRequestClinic")
  nurseProfiles       NurseProfile[]
  shifts              Shift[]
  firstAidKits        FirstAidKit[]
  aedDevices          AedDevice[]
  safetyInspections   SafetyInspection[]
  scienceLabs         ScienceLab[]

  @@map("clinics")
}

model Canteen {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  location  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school      School               @relation(fields: [schoolId], references: [id])
  inspections CanteenInspection[]

  @@map("canteens")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               UserRole
  roleId             String?   @map("role_id") @db.Uuid
  clinicId           String?   @map("clinic_id") @db.Uuid
  fullName           String    @map("full_name")
  phone              String?
  isActive           Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  roleRecord       Role?              @relation(fields: [roleId], references: [id])
  clinic           Clinic?            @relation(fields: [clinicId], references: [id])
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  visitsAsNurse    Visit[]            @relation("VisitNurse")
  referralsCreated StudentReferral[]  @relation("ReferralCreator")
  marRecords       MedicationAdministration[]
  inventoryTx      InventoryTransaction[]
  circularsIssued  Circular[]
  circularReceipts CircularReceipt[]
  notifications    Notification[]
  psychologySessions PsychologySession[]
  socialCases      SocialCase[]
  internalReferralsFrom InternalReferral[] @relation("InternalReferFrom")
  internalReferralsTo   InternalReferral[] @relation("InternalReferTo")
  nurseProfile     NurseProfile?
  canteenInspections CanteenInspection[]
  safetyInspections SafetyInspection[]
  importJobs       ImportJob[]
  savedFilters     SavedFilter[]
  stockRequestsCreated InternalStockRequest[] @relation("StockRequestRequester")
  stockRequestsReviewed InternalStockRequest[] @relation("StockRequestReviewer")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  deviceInfo String?  @map("device_info")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  actionType   String   @map("action_type")
  tableName    String   @map("table_name")
  recordId     String?  @map("record_id") @db.Uuid
  oldValueJson Json?    @map("old_value_json")
  newValueJson Json?    @map("new_value_json")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([tableName])
  @@map("audit_logs")
}

model Counter {
  scope String
  year  Int
  value Int    @default(0)

  @@id([scope, year])
  @@map("counters")
}

model IdempotencyKey {
  key           String   @id
  route         String
  responseHash  String?  @map("response_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}

model Student {
  id              String    @id @default(uuid()) @db.Uuid
  academicNumber  String    @unique @map("academic_number")
  qrCode          String    @unique @map("qr_code")
  name            String
  grade           String
  class           String
  clinicId        String    @map("clinic_id") @db.Uuid
  guardianName    String    @map("guardian_name")
  guardianPhone   String    @map("guardian_phone")
  guardianPhoneAlt String?  @map("guardian_phone_alt")
  guardianEmail   String?   @map("guardian_email")
  photoUrl        String?   @map("photo_url")
  bloodType       String?   @map("blood_type")
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          Gender?
  isActive        Boolean   @default(true) @map("is_active")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  clinic              Clinic                    @relation(fields: [clinicId], references: [id])
  guardians           Guardian[]
  studentReferrals    StudentReferral[]
  psychologySessions  PsychologySession[]
  socialCases         SocialCase[]
  foodIncidentLinks   FoodIncidentStudent[]
  frequentAlerts      FrequentVisitorAlert[]
  guardianPrefs       GuardianNotificationPreference[]
  medicationOrders    StudentMedicationOrder[]

  @@index([academicNumber])
  @@index([qrCode])
  @@index([clinicId])
  @@index([name])
  @@map("students")
}

model Guardian {
  id                      String   @id @default(uuid()) @db.Uuid
  studentId               String   @map("student_id") @db.Uuid
  name                    String
  relationship            String
  phone                   String
  phoneAlt                String?  @map("phone_alt")
  email                   String?
  address                 String?
  notificationPreferences Json     @default("{}") @map("notification_preferences")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("guardians")
}

model Employee {
  id              String    @id @default(uuid()) @db.Uuid
  employeeNumber  String    @unique @map("employee_number")
  name            String
  department      String
  jobTitle        String    @map("job_title")
  clinicId        String?   @map("clinic_id") @db.Uuid
  phone           String
  phoneAlt        String?   @map("phone_alt")
  email           String?
  hireDate        DateTime? @map("hire_date") @db.Date
  employmentStatus String   @default("active") @map("employment_status")
  bloodType       String?   @map("blood_type")
  isActive        Boolean   @default(true) @map("is_active")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  clinic                Clinic?                  @relation(fields: [clinicId], references: [id])
  medicalRecommendations MedicalRecommendation[]
  foodIncidentLinks     FoodIncidentEmployee[]
  nurseProfile          NurseProfile?

  @@index([employeeNumber])
  @@index([clinicId])
  @@map("employees")
}
model MedicalProfile {
  id        String    @id @default(uuid()) @db.Uuid
  ownerType OwnerType @map("owner_type")
  ownerId   String    @map("owner_id") @db.Uuid
  notes     String?
  bloodType String?   @map("blood_type")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  allergies              Allergy[]
  chronicConditions      ChronicCondition[]
  continuousMedications  ContinuousMedication[]
  vaccinations           Vaccination[]
  growthMeasurements     GrowthMeasurement[]
  visionScreenings       VisionScreening[]
  injuries               Injury[]

  @@unique([ownerType, ownerId])
  @@map("medical_profiles")
}

model Allergy {
  id        String          @id @default(uuid()) @db.Uuid
  profileId String          @map("profile_id") @db.Uuid
  type      String
  severity  AllergySeverity
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at")

  profile MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("allergies")
}

model ChronicCondition {
  id            String    @id @default(uuid()) @db.Uuid
  profileId     String    @map("profile_id") @db.Uuid
  diagnosis     String
  diagnosisDate DateTime? @map("diagnosis_date") @db.Date
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  profile MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("chronic_conditions")
}

model ContinuousMedication {
  id             String   @id @default(uuid()) @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  medicationName String   @map("medication_name")
  dose           String?
  frequency      String?
  createdAt      DateTime @default(now()) @map("created_at")

  profile MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("continuous_medications")
}

model Vaccination {
  id               String    @id @default(uuid()) @db.Uuid
  profileId        String    @map("profile_id") @db.Uuid
  vaccineName      String    @map("vaccine_name")
  doseNumber       Int?      @map("dose_number")
  administeredDate DateTime  @map("administered_date") @db.Date
  source           String?
  attachmentUrl    String?   @map("attachment_url")
  createdAt        DateTime  @default(now()) @map("created_at")

  profile MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("vaccinations")
}

model GrowthMeasurement {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  measuredAt DateTime @map("measured_at")
  weightKg   Decimal? @map("weight_kg") @db.Decimal(5, 2)
  heightCm   Decimal? @map("height_cm") @db.Decimal(5, 2)
  bmi        Decimal? @db.Decimal(5, 2)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  profile MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("growth_measurements")
}

model VisionScreening {
  id              String    @id @default(uuid()) @db.Uuid
  profileId       String    @map("profile_id") @db.Uuid
  screenedAt      DateTime  @map("screened_at")
  rightEye        String?   @map("right_eye")
  leftEye         String?   @map("left_eye")
  withGlasses     String?   @map("with_glasses")
  withoutGlasses  String?   @map("without_glasses")
  recommendation  String?
  createdAt       DateTime  @default(now()) @map("created_at")

  profile MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("vision_screenings")
}

model Injury {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  injuryDate  DateTime @map("injury_date")
  description String
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  profile MedicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("injuries")
}

model Visit {
  id              String        @id @default(uuid()) @db.Uuid
  visitNumber     String        @unique @map("visit_number")
  dateTime        DateTime      @map("date_time")
  clinicId        String        @map("clinic_id") @db.Uuid
  nurseId         String        @map("nurse_id") @db.Uuid
  visitorType     VisitorType   @map("visitor_type")
  visitorId       String        @map("visitor_id") @db.Uuid
  reasonsJson     Json          @map("reasons_json")
  triageLevel     TriageLevel   @map("triage_level")
  triageReason    String?       @map("triage_reason")
  triageAction    String?       @map("triage_action")
  status          VisitStatus   @default(OPEN)
  outcome         VisitOutcome?
  entryTime       DateTime      @map("entry_time")
  exitTime        DateTime?     @map("exit_time")
  durationMinutes Int?          @map("duration_minutes")
  procedure       String?
  recommendations String?
  notes           String?
  isDeleted       Boolean       @default(false) @map("is_deleted")
  deletedAt       DateTime?     @map("deleted_at")
  deletedBy       String?       @map("deleted_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  nurse        User          @relation("VisitNurse", fields: [nurseId], references: [id])
  vitalSigns   VitalSign?
  diagnoses    Diagnosis[]
  treatments   Treatment[]
  referrals    Referral[]
  recommendationsMed MedicalRecommendation[]

  @@index([dateTime])
  @@index([clinicId])
  @@index([visitorType, visitorId])
  @@index([status])
  @@map("visits")
}

model VitalSign {
  id                     String   @id @default(uuid()) @db.Uuid
  visitId                String   @unique @map("visit_id") @db.Uuid
  temperature            Decimal? @db.Decimal(4, 2)
  bloodPressureSystolic  Int?     @map("blood_pressure_systolic")
  bloodPressureDiastolic Int?     @map("blood_pressure_diastolic")
  pulse                  Int?
  respirationRate        Int?     @map("respiration_rate")
  spo2                   Int?
  bloodSugar             Int?     @map("blood_sugar")
  weight                 Decimal? @db.Decimal(5, 2)
  height                 Decimal? @db.Decimal(5, 2)
  bmi                    Decimal? @db.Decimal(5, 2)
  recordedAt             DateTime @default(now()) @map("recorded_at")

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("vital_signs")
}

model Diagnosis {
  id            String  @id @default(uuid()) @db.Uuid
  visitId       String  @map("visit_id") @db.Uuid
  diagnosisCode String? @map("diagnosis_code")
  diagnosisName String  @map("diagnosis_name")
  notes         String?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("diagnoses")
}

model Treatment {
  id            String @id @default(uuid()) @db.Uuid
  visitId       String @map("visit_id") @db.Uuid
  treatmentType String @map("treatment_type")
  description   String
  notes         String?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("treatments")
}

model Referral {
  id           String    @id @default(uuid()) @db.Uuid
  visitId      String    @map("visit_id") @db.Uuid
  referralType String    @map("referral_type")
  hospitalName String?   @map("hospital_name")
  doctorName   String?   @map("doctor_name")
  referralDate DateTime? @map("referral_date")
  notes        String?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("referrals")
}

model StudentReferral {
  id                  String                @id @default(uuid()) @db.Uuid
  referralNumber      String                @unique @map("referral_number")
  studentId           String                @map("student_id") @db.Uuid
  referredById        String                @map("referred_by") @db.Uuid
  referredByName      String                @map("referred_by_name")
  referredByRole      String                @map("referred_by_role")
  reasonCategory      ReferralReasonCategory @map("reason_category")
  reasonDetails       String?               @map("reason_details")
  severity            ReferralSeverity      @default(NORMAL)
  status              StudentReferralStatus @default(PENDING)
  referralTime        DateTime              @default(now()) @map("referral_time")
  receivedTime        DateTime?             @map("received_time")
  treatmentStartTime  DateTime?             @map("treatment_start_time")
  treatmentEndTime    DateTime?             @map("treatment_end_time")
  departureTime       DateTime?             @map("departure_time")
  waitingMinutes      Int?                  @map("waiting_minutes")
  treatmentMinutes    Int?                  @map("treatment_minutes")
  totalMinutes        Int?                  @map("total_minutes")
  diagnosis           String?
  procedure           String?
  recommendations     String?
  outcome             VisitOutcome?
  guardianNotified    Boolean               @default(false) @map("guardian_notified")
  guardianNotifiedAt  DateTime?             @map("guardian_notification_time")
  clinicId            String                @map("clinic_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  student    Student @relation(fields: [studentId], references: [id])
  referredBy User    @relation("ReferralCreator", fields: [referredById], references: [id])
  clinic     Clinic  @relation(fields: [clinicId], references: [id])

  @@index([status, referralTime])
  @@index([studentId])
  @@map("student_referrals")
}

model EmergencyCase {
  id                   String         @id @default(uuid()) @db.Uuid
  caseNumber           String         @unique @map("case_number")
  eventTime            DateTime       @map("event_time")
  location             String
  visitorType          VisitorType    @map("visitor_type")
  visitorId            String         @map("visitor_id") @db.Uuid
  vitalSignsJson       Json?          @map("vital_signs_json")
  interventionsJson    Json?          @map("interventions_json")
  medicationsUsedJson  Json?          @map("medications_used_json")
  responseLevel        ResponseLevel? @map("response_level")
  referralDecision     Boolean?       @map("referral_decision")
  guardianContactTime  DateTime?      @map("guardian_contact_time")
  ambulanceArrivalTime DateTime?      @map("ambulance_arrival_time")
  hospitalName         String?        @map("hospital_name")
  outcome              String?
  status               String         @default("open")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@map("emergency_cases")
}

model MedicalRecommendation {
  id                     String               @id @default(uuid()) @db.Uuid
  employeeId             String               @map("employee_id") @db.Uuid
  visitId                String?              @map("visit_id") @db.Uuid
  recommendationType     String               @map("recommendation_type")
  description            String
